# =====================================================
# AKRITI DIAGNOSTICS CENTER  ENVIRONMENT VARIABLES
# =====================================================
# Copy this file to .env and fill in your real values
# Never commit .env to version control!

# --- Database ---
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT Security ---
# Generate a strong random string: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_super_secret_key_here
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# --- Brevo Email API Configuration ---
BREVO_API_KEY=your_brevo_api_key_here
MAIL_FROM=your_email@example.com
MAIL_FROM_NAME=Akriti Diagnostics Center

# --- WASender API Configuration ---
WASENDER_API_KEY=your_wasender_api_key_here

# --- Lab Configuration ---
LAB_UPI_VPA=your_upi_vpa@bank
LAB_NAME=Akriti Diagnostics Center
LAB_ADDRESS=Your Lab Address Here
LAB_PHONE=9876543210
LAB_GSTIN=

# --- Face Recognition ---
FACE_MATCH_THRESHOLD=0.6
DISABLE_PGVECTOR=false

# --- Seeding ---
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_TEMP_PASSWORD=YourSecurePassword123

# --- Google reCAPTCHA (v3) ---
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
ENABLE_RECAPTCHA=true

# --- Environment ---
# Set to "production" on the live server; leave as "development" locally
ENVIRONMENT=development

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- CORS (production: set to your actual domain) ---
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://akriti.yourdomain.com

# --- Storage (Local / Supabase) ---
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://your_supabase_project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# --- AI Models ---
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
GROQ_API_KEY=your_groq_api_key

# --- Security ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
PASSWORD_PEPPER=your_password_pepper_here
LAB_PHONE=9876543210
LAB_GSTIN=
# --- Face Recognition ---
FACE_MATCH_THRESHOLD=0.6
DISABLE_PGVECTOR=true
# --- Seeding ---
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_TEMP_PASSWORD=Admin123!
# --- Google reCAPTCHA (v3) ---
RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here
ENABLE_RECAPTCHA=true
# --- Environment ---
# Set to "production" on the live server; leave as "development" locally
ENVIRONMENT=development
# --- Server ---
HOST=0.0.0.0
PORT=8000
# --- CORS (production: set to your actual domain) ---
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://akriti.yourdomain.com
# --- Storage (Local / Supabase) ---
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here
# --- NVIDIA LLM ---
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
PASSWORD_PEPPER=your_password_pepper_here
GROQ_API_KEY=your_groq_api_key_here
